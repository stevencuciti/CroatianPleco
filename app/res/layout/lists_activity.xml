<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/topbar" />

    <!-- Tabs: Bookmarks / History -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="6dp"
        android:background="@drawable/lists_segment_track"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lists_tab_bookmarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/lists_segment"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/lists_tab_bookmarks"
            android:textColor="@color/lists_segment_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/lists_tab_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/lists_segment"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/lists_tab_history"
            android:textColor="@color/lists_segment_text"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lists_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@drawable/lists_divider"
            android:dividerHeight="1px"
            android:paddingBottom="8dp"
            android:scrollbarStyle="outsideOverlay" />

        <ScrollView
            android:id="@+id/lists_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="64dp"
                android:paddingEnd="32dp"
                android:paddingBottom="32dp">

                <ImageView
                    android:id="@+id/lists_empty_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.6"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_border" />

                <TextView
                    android:id="@+id/lists_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/lists_empty_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
