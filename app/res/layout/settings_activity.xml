<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/topbar" />

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter">

            <!-- ============================================================ Pronunciation -->
            <TextView
                style="@style/settings_Section"
                android:paddingTop="8dp"
                android:text="@string/settings_section_pronunciation" />

            <LinearLayout style="@style/settings_Card">

                <TextView
                    style="@style/settings_Label"
                    android:text="@string/settings_voice_label" />

                <RadioGroup
                    android:id="@+id/settings_engine_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_voice_label"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <RadioButton
                        android:id="@+id/settings_engine_auto"
                        style="@style/settings_Radio"
                        android:text="@string/settings_engine_auto" />

                    <RadioButton
                        android:id="@+id/settings_engine_system"
                        style="@style/settings_Radio"
                        android:text="@string/settings_engine_system" />

                    <RadioButton
                        android:id="@+id/settings_engine_espeak"
                        style="@style/settings_Radio"
                        android:text="@string/settings_engine_espeak" />
                </RadioGroup>

                <View style="@style/settings_Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/settings_rate_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:labelFor="@+id/settings_rate"
                        android:text="@string/settings_speed_label"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/settings_rate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:importantForAccessibility="no"
                        android:textColor="@color/accent"
                        android:textSize="16sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/settings_rate"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch"
                    android:contentDescription="@string/settings_speed_label"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:saveEnabled="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_speed_slower"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_speed_faster"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/settings_Card"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/settings_Label"
                    android:text="@string/settings_status_label" />

                <TextView
                    android:id="@+id/settings_voice_status"
                    style="@style/settings_Body"
                    android:accessibilityLiveRegion="polite"
                    android:paddingTop="2dp"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <Button
                        android:id="@+id/settings_test_hr"
                        style="@style/settings_Button"
                        android:layout_marginEnd="6dp"
                        android:text="@string/settings_test_hr" />

                    <Button
                        android:id="@+id/settings_test_kaj"
                        style="@style/settings_Button"
                        android:layout_marginStart="6dp"
                        android:text="@string/settings_test_kaj" />
                </LinearLayout>

                <View style="@style/settings_Divider" />

                <TextView
                    style="@style/settings_Body"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/settings_voice_help" />

                <View style="@style/settings_Divider" />

                <LinearLayout
                    android:id="@+id/settings_install_voice"
                    style="@style/settings_Row">

                    <ImageView
                        style="@style/settings_RowIcon"
                        android:src="@drawable/settings_ic_download" />

                    <LinearLayout style="@style/settings_RowText">

                        <TextView
                            style="@style/settings_RowTitle"
                            android:text="@string/settings_install_voice" />

                        <TextView
                            style="@style/settings_RowSummary"
                            android:text="@string/settings_install_voice_summary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/settings_RowTrailingIcon"
                        android:src="@drawable/settings_ic_open" />
                </LinearLayout>

                <View style="@style/settings_Divider" />

                <LinearLayout
                    android:id="@+id/settings_tts_settings"
                    style="@style/settings_Row">

                    <ImageView
                        style="@style/settings_RowIcon"
                        android:src="@drawable/ic_settings" />

                    <LinearLayout style="@style/settings_RowText">

                        <TextView
                            style="@style/settings_RowTitle"
                            android:text="@string/settings_tts_settings" />

                        <TextView
                            style="@style/settings_RowSummary"
                            android:text="@string/settings_tts_settings_summary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/settings_RowTrailingIcon"
                        android:src="@drawable/settings_ic_open" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================ Display -->
            <TextView
                style="@style/settings_Section"
                android:text="@string/settings_section_display" />

            <LinearLayout style="@style/settings_Card">

                <Switch
                    android:id="@+id/settings_show_accents"
                    style="@style/settings_Switch"
                    android:text="@string/settings_accents" />

                <View style="@style/settings_Divider" />

                <Switch
                    android:id="@+id/settings_show_kajkavian"
                    style="@style/settings_Switch"
                    android:text="@string/settings_kajkavian" />

                <View style="@style/settings_Divider" />

                <TextView
                    style="@style/settings_Label"
                    android:text="@string/settings_theme_label" />

                <RadioGroup
                    android:id="@+id/settings_theme_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_theme_label"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <RadioButton
                        android:id="@+id/settings_theme_system"
                        style="@style/settings_Radio"
                        android:text="@string/settings_theme_system" />

                    <RadioButton
                        android:id="@+id/settings_theme_light"
                        style="@style/settings_Radio"
                        android:text="@string/settings_theme_light" />

                    <RadioButton
                        android:id="@+id/settings_theme_dark"
                        style="@style/settings_Radio"
                        android:text="@string/settings_theme_dark" />
                </RadioGroup>
            </LinearLayout>

            <!-- ============================================================ Data -->
            <TextView
                style="@style/settings_Section"
                android:text="@string/settings_section_data" />

            <LinearLayout style="@style/settings_Card">

                <LinearLayout
                    style="@style/settings_InfoRow"
                    android:focusable="true">

                    <ImageView
                        style="@style/settings_RowIcon"
                        android:src="@drawable/settings_ic_book" />

                    <LinearLayout style="@style/settings_RowText">

                        <TextView
                            style="@style/settings_RowTitle"
                            android:text="@string/settings_dictionary_label" />

                        <TextView
                            android:id="@+id/settings_dictionary_size"
                            style="@style/settings_RowSummary"
                            android:text="@string/settings_dictionary_loading" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/settings_Divider" />

                <LinearLayout
                    android:id="@+id/settings_clear_history"
                    style="@style/settings_Row">

                    <ImageView
                        style="@style/settings_RowIcon"
                        android:src="@drawable/ic_history" />

                    <LinearLayout style="@style/settings_RowText">

                        <TextView
                            style="@style/settings_RowTitle"
                            android:text="@string/settings_clear_history" />

                        <TextView
                            android:id="@+id/settings_history_summary"
                            style="@style/settings_RowSummary"
                            android:text="@string/settings_dictionary_loading" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================ About -->
            <LinearLayout
                style="@style/settings_Card"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/settings_open_about"
                    style="@style/settings_Row">

                    <ImageView
                        style="@style/settings_RowIcon"
                        android:src="@drawable/ic_info" />

                    <LinearLayout style="@style/settings_RowText">

                        <TextView
                            style="@style/settings_RowTitle"
                            android:text="@string/settings_about" />

                        <TextView
                            style="@style/settings_RowSummary"
                            android:text="@string/settings_about_summary" />
                    </LinearLayout>

                    <ImageView
                        style="@style/settings_RowTrailingIcon"
                        android:src="@drawable/settings_ic_chevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
