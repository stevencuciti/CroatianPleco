<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/topbar" />

    <!-- Search field -->
    <LinearLayout
        android:id="@+id/main_search_box"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/gutter"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/main_query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/main_search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/main_clear"
            style="@style/TopBarButton"
            android:contentDescription="@string/main_clear"
            android:src="@drawable/ic_clear"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Search direction: Auto · HR→EN · EN→HR -->
    <LinearLayout
        android:id="@+id/main_modes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="6dp"
        android:background="@drawable/main_segment_track"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/main_mode_auto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/main_segment"
            android:contentDescription="@string/main_mode_auto_desc"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/main_mode_auto"
            android:textColor="@color/main_segment_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/main_mode_hr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/main_segment"
            android:contentDescription="@string/main_mode_hr_desc"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/main_mode_hr"
            android:textColor="@color/main_segment_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/main_mode_en"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/main_segment"
            android:contentDescription="@string/main_mode_en_desc"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/main_mode_en"
            android:textColor="@color/main_segment_text"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Search results -->
        <ListView
            android:id="@+id/main_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@drawable/main_divider"
            android:dividerHeight="1px"
            android:paddingBottom="8dp"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="gone" />

        <!-- Home: word of the day + recent history -->
        <ScrollView
            android:id="@+id/main_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/main_wotd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginEnd="@dimen/gutter"
                    android:background="@drawable/main_card"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/gutter"
                    android:paddingTop="14dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_wotd" />

                    <LinearLayout
                        android:id="@+id/main_wotd_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/main_wotd_word"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/text_primary"
                                    android:textSize="28sp" />

                                <TextView
                                    android:id="@+id/main_wotd_meta"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/main_wotd_speak"
                                style="@style/TopBarButton"
                                android:contentDescription="@string/speak"
                                android:src="@drawable/ic_speaker" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/main_wotd_gloss"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="12dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="3"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/main_wotd_kaj"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="12dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/kaj"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Shown while the dictionary is copied out of the APK on first launch -->
                    <LinearLayout
                        android:id="@+id/main_wotd_preparing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ProgressBar
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminate="true" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/main_preparing"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Links to Bookmarks and History -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="@dimen/gutter"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/main_link_bookmarks"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/main_btn"
                        android:clickable="true"
                        android:contentDescription="@string/main_menu_bookmarks"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bookmarks" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:importantForAccessibility="no"
                            android:text="@string/main_menu_bookmarks"
                            android:textColor="@color/accent"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/main_link_history"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/main_btn"
                        android:clickable="true"
                        android:contentDescription="@string/main_menu_history"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_history" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:importantForAccessibility="no"
                            android:text="@string/main_menu_history"
                            android:textColor="@color/accent"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/main_recent" />

                <LinearLayout
                    android:id="@+id/main_recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/main_recent_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gutter"
                    android:paddingTop="8dp"
                    android:paddingEnd="@dimen/gutter"
                    android:paddingBottom="8dp"
                    android:text="@string/main_recent_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="@dimen/gutter"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/main_tip"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Preparing / no results / error -->
        <ScrollView
            android:id="@+id/main_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="48dp"
                android:paddingEnd="32dp"
                android:paddingBottom="32dp">

                <ProgressBar
                    android:id="@+id/main_state_progress"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true" />

                <ImageView
                    android:id="@+id/main_state_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.6"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search" />

                <TextView
                    android:id="@+id/main_state_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/main_state_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/main_state_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/main_btn"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
