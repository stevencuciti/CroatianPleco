<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/topbar" />

    <ScrollView
        android:id="@+id/about_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter">

            <!-- ============================================================ Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/about_tagline"
                    android:textColor="@color/accent"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/about_Body"
                android:paddingStart="4dp"
                android:paddingTop="16dp"
                android:paddingEnd="4dp"
                android:text="@string/about_description" />

            <!-- ============================================================ Dictionary -->
            <TextView
                style="@style/about_Section"
                android:text="@string/about_section_dictionary" />

            <LinearLayout style="@style/about_Card">

                <LinearLayout style="@style/about_StatRow">

                    <TextView
                        style="@style/about_StatLabel"
                        android:text="@string/about_stat_entries" />

                    <TextView
                        android:id="@+id/about_entries"
                        style="@style/about_StatValue" />
                </LinearLayout>

                <View style="@style/about_Divider" />

                <LinearLayout style="@style/about_StatRow">

                    <TextView
                        style="@style/about_StatLabel"
                        android:text="@string/about_stat_enriched" />

                    <TextView
                        android:id="@+id/about_enriched"
                        style="@style/about_StatValue" />
                </LinearLayout>

                <View style="@style/about_Divider" />

                <LinearLayout style="@style/about_StatRow">

                    <TextView
                        style="@style/about_StatLabel"
                        android:text="@string/about_stat_variety" />

                    <TextView
                        android:id="@+id/about_variety"
                        style="@style/about_StatValue"
                        android:textColor="@color/kaj" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================ Sources & licences -->
            <TextView
                style="@style/about_Section"
                android:text="@string/about_section_sources" />

            <LinearLayout style="@style/about_Card">

                <LinearLayout style="@style/about_Item">

                    <LinearLayout style="@style/about_ItemTitleRow">

                        <TextView
                            style="@style/about_ItemTitle"
                            android:text="@string/about_wikt_title" />

                        <TextView
                            style="@style/about_Pill"
                            android:text="@string/about_wikt_licence" />
                    </LinearLayout>

                    <TextView
                        style="@style/about_Body"
                        android:text="@string/about_wikt_body" />

                    <TextView
                        style="@style/about_Url"
                        android:paddingTop="8dp"
                        android:text="@string/about_wikt_url" />

                    <TextView
                        style="@style/about_Url"
                        android:text="@string/about_wikt_licence_url" />
                </LinearLayout>

                <View style="@style/about_Divider" />

                <LinearLayout style="@style/about_Item">

                    <TextView
                        style="@style/about_ItemTitle"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="@string/about_kaikki_title" />

                    <TextView
                        style="@style/about_Body"
                        android:text="@string/about_kaikki_body" />

                    <TextView
                        style="@style/about_Url"
                        android:paddingTop="8dp"
                        android:text="@string/about_kaikki_url" />
                </LinearLayout>

                <View style="@style/about_Divider" />

                <LinearLayout style="@style/about_Item">

                    <LinearLayout style="@style/about_ItemTitleRow">

                        <TextView
                            style="@style/about_ItemTitle"
                            android:text="@string/about_espeak_title" />

                        <TextView
                            style="@style/about_Pill"
                            android:text="@string/about_espeak_licence" />
                    </LinearLayout>

                    <TextView
                        style="@style/about_Body"
                        android:text="@string/about_espeak_body" />

                    <TextView
                        style="@style/about_Url"
                        android:paddingTop="8dp"
                        android:text="@string/about_espeak_url" />
                </LinearLayout>

                <View style="@style/about_Divider" />

                <LinearLayout style="@style/about_Item">

                    <LinearLayout style="@style/about_ItemTitleRow">

                        <TextView
                            style="@style/about_ItemTitle"
                            android:text="@string/about_app_title" />

                        <TextView
                            style="@style/about_Pill"
                            android:text="@string/about_app_licence" />
                    </LinearLayout>

                    <TextView
                        style="@style/about_Body"
                        android:text="@string/about_app_body" />

                    <TextView
                        style="@style/about_Url"
                        android:paddingTop="8dp"
                        android:text="@string/about_app_url" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================ AI-generated content -->
            <TextView
                style="@style/about_Section"
                android:text="@string/about_section_ai" />

            <LinearLayout style="@style/about_Card">

                <LinearLayout style="@style/about_Item">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/about_bg_ai_tag"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/tag_ai"
                        android:textColor="@color/ai_tag"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/about_Body"
                        android:text="@string/about_ai_body" />

                    <TextView
                        style="@style/about_Body"
                        android:paddingTop="10dp"
                        android:text="@string/about_ai_low_confidence"
                        android:textColor="@color/kaj" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================ Offline -->
            <TextView
                style="@style/about_Section"
                android:text="@string/about_section_offline" />

            <LinearLayout style="@style/about_Card">

                <LinearLayout style="@style/about_Item">

                    <TextView
                        style="@style/about_Body"
                        android:paddingTop="0dp"
                        android:text="@string/about_offline_body" />

                    <TextView
                        style="@style/about_Secondary"
                        android:paddingTop="8dp"
                        android:text="@string/about_offline_voice" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/about_Secondary"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingTop="20dp"
                android:paddingEnd="8dp"
                android:text="@string/about_links_note"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
